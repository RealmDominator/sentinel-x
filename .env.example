# Copy this file to `.env` (same folder) and fill in what you have.
# `.env` is git-ignored. Real environment variables override values here.

# --- Real malware data (scripts/fetch_cert_corpus.py, scripts/real_world_eval.py --bazaar)
# Free key: https://auth.abuse.ch/
MALWAREBAZAAR_API_KEY=

# --- Live GenAI narrative (optional; templates are used when none is set)
# The first key found is used, in this order. Set SENTINELX_LLM_PROVIDER to force one.
# Free, no card: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Free, no card: https://console.groq.com/keys
GROQ_API_KEY=
# Free models end in ":free"; set SENTINELX_MODEL to one, e.g. from https://openrouter.ai/models?q=free
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# auto | gemini | groq | openrouter | anthropic
SENTINELX_LLM_PROVIDER=auto
# Leave empty for the provider default (gemini-3.8-flash / openai/gpt-oss-120b / claude-opus-5)
SENTINELX_MODEL=

# Cached analyses older than this many days are purged at startup (0 = keep forever)
SENTINELX_RETENTION_DAYS=30

# --- Dynamic analysis: the only setting that lets SENTINEL-X execute a sample.
# Off unless you set it, and still opt-in per upload.
#   none      static only (default)
#   emulator  local throwaway rooted AVD + Frida, DNS forced to the sinkhole.
#             Run `python scripts/setup_dynamic.py --install` once first.
#   triage    Hatching Triage. Submitting PUBLISHES the sample, so it is allowed
#             only on the evaluation path, for samples already public.
#   mock      scripted events — see the feature work without an emulator
SENTINELX_DYNAMIC_BACKEND=none
# Seconds the sample is left running (2-4 minutes is the useful range)
SENTINELX_DYNAMIC_TIMEOUT=180
# Must be a google_apis image, NOT google_apis_playstore: Play Store builds
# refuse `adb root`, so frida-server cannot start.
SENTINELX_AVD_NAME=sentinelx_detonator
# Where the APK is written for `adb install`, then deleted. Keep it OUT of
# OneDrive — Defender quarantines malware in synced folders.
SENTINELX_DYNAMIC_WORKDIR=
# Free research key: https://tria.ge
TRIAGE_API_KEY=
